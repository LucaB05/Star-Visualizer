  <property name="styleSheet">
   <string notr="true">QWidget {
    background-color: black;
    color: white;
}

QFrame#adminContentFrame,
QFrame#adminMenuCard,
QFrame#settingsContentFrame,
QFrame#addUserContentFrame,
QFrame#starEditorFrame {
    background-color: #090909;
    border: 1px solid #303030;
    border-radius: 10px;
}

QLabel#pageTitleLabel,
QLabel#userSettingsTitleLabel,
QLabel#starSettingsTitleLabel {
    font-size: 28px;
    font-weight: bold;
}

QLabel#pageSubtitleLabel,
QLabel#userSettingsSubtitleLabel,
QLabel#starSettingsSubtitleLabel {
    color: #bdbdbd;
}

QLineEdit,
QComboBox,
QDoubleSpinBox,
QSpinBox,
QTextEdit {
    border: 1px solid #666666;
    border-radius: 8px;
    padding: 8px;
    background-color: #111111;
    color: white;
}

QPushButton {
    color: white;
    background-color: black;
    border: 1px solid #777777;
    border-radius: 8px;
    padding: 10px 14px;
}

QPushButton:hover {
    border-color: #aaaaaa;
}

QPushButton#deleteUserButton,
QPushButton#deleteStarButton,
QPushButton#cancelAddUserButton {
    border-color: #b94a48;
}

QPushButton#saveUserButton,
QPushButton#saveStarButton,
QPushButton#addUserButton,
QPushButton#addStarButton,
QPushButton#addUserConfirmButton {
    border-color: #c9a227;
}

QPushButton#addUserConfirmButton {
    border-color: #2f9e44;
}

QPushButton#generateStarPositionButton {
    border-color: #2f9e44;
}</string>
